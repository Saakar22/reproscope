# Copy to backend/.env (or the repo root .env) and fill in. Real environment variables win.

# --- LLM ------------------------------------------------------------------
# Groq (free tier) is the default; any OpenAI-compatible endpoint also works
# (set LLM_PROVIDER=openai_compatible, LLM_BASE_URL and LLM_API_KEY).
# Without a key, ReproScope runs in "dev" mode: LLM stages use clearly labelled
# deterministic sample outputs that are never presented as real analysis.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Strict JSON-schema decoding (supported by Groq's openai/gpt-oss-* models).
# Set to false for models that only support JSON-object mode.
LLM_STRICT_JSON=true

# --- Storage ----------------------------------------------------------------
# SQLite database + per-job artifacts (PDFs, repo copies, logs, stage JSON).
# Keep this path short on Windows (260-character path limit).
# REPROSCOPE_DATA_DIR=C:\reproscope-data

# --- Upload limits ------------------------------------------------------------
REPROSCOPE_MAX_PDF_MB=30
REPROSCOPE_MAX_ZIP_MB=100
REPROSCOPE_MAX_REPO_MB=500
REPROSCOPE_GIT_TIMEOUT_S=120
REPROSCOPE_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# --- Experiment sandbox (Docker) ---------------------------------------------
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_TIMEOUT_S=600
SANDBOX_PYTHON=3.11

# --- Frontend origin(s) allowed by CORS --------------------------------------
REPROSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
